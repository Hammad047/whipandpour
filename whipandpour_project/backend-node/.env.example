# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ──────────────────────────────────────────────────────────────
# Leave all of these unset for local dev — defaults to a SQLite file next to
# this project (whipandpour.db), no server needed.
#
# For MySQL (e.g. Hostinger's hPanel → Databases → MySQL Databases), set:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Server port (default: 8000)
PORT=8000

# Set to "production" in production
NODE_ENV=development

# ─── Split deployment (frontend and backend on different domains) ────────────
# Needed when the frontend is static-hosted elsewhere and this API runs on its
# own host/subdomain. Leave both unset/false for a same-origin deployment.
ALLOWED_ORIGINS=https://whipandpour.com,https://www.whipandpour.com,http://localhost:5173
CROSS_SITE_COOKIES=false

# ─── Admin account ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@whipandpour.com
ADMIN_PASSWORD=t

# ─── Stripe keys (get from https://dashboard.stripe.com/apikeys) ─────────────
STRIPE_SECRET_KEY=sk_test_your_key_here

# ─── Email (Hostinger SMTP) ───────────────────────────────────────────────────
# Create a mailbox in hPanel → Emails, then use its full address and password.
# Port 465 uses implicit SSL; 587 uses STARTTLS. Both work with Hostinger.
# MAIL_FROM must match SMTP_USER — Hostinger rejects mismatched senders.
MAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=owner@whipandpour.com
SMTP_PASSWORD=your_mailbox_password
MAIL_FROM=owner@whipandpour.com
MAIL_FROM_NAME=Whip & Pour

# Optional: internal copy of every new order (leave blank to disable)
MAIL_ADMIN=owner@whipandpour.com

# Used for the "Track your order" link inside the email, and sitemap.xml
STORE_URL=https://whipandpour.com

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
