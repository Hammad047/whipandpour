# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ──────────────────────────────────────────────────────────────
# Leave all of these unset for local dev — defaults to a SQLite file next to
# this project (whipandpour.db), no server needed.
#
# For MySQL (e.g. Hostinger's hPanel → Databases → MySQL Databases), set:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Server port (default: 8000)
PORT=8000

# Set to "production" in production
NODE_ENV=development

# ─── Split deployment (frontend and backend on different domains) ────────────
# Needed when the frontend is static-hosted elsewhere and this API runs on its
# own host/subdomain. Leave both unset/false for a same-origin deployment.
ALLOWED_ORIGINS=https://whipandpour.com,https://www.whipandpour.com,http://localhost:5173
CROSS_SITE_COOKIES=false
# Public origin of this API. Uploaded image URLs are built from it, so it must
# be set in production or uploads are saved with an unreachable localhost URL.
PUBLIC_API_URL=https://api.whipandpour.com

# ─── Keep-alive / health checker ─────────────────────────────────────────────
# Free hosts (Render free tier) spin a service down after ~15 minutes with no
# inbound traffic. The backend pings its own PUBLIC url on an interval to keep
# that clock from running out. On Render, RENDER_EXTERNAL_URL is injected
# automatically and nothing here needs setting.
# Must be the public address — a localhost ping never reaches the edge router
# that decides to sleep, so the keep-alive disables itself for loopback urls.
KEEPALIVE_URL=https://your-service.onrender.com/api/health
KEEPALIVE_ENABLED=true
# 300s (5 min) against a 15 minute idle timer, so one failed ping cannot let
# the service sleep before the next one lands.
KEEPALIVE_INTERVAL_SECONDS=300
# Log every ping instead of only healthy/unhealthy transitions.
KEEPALIVE_VERBOSE=false

# ─── Visitor analytics ───────────────────────────────────────────────────────
# Visitor IDs are an HMAC of IP + user agent, never a stored IP address. Leave
# ANALYTICS_SALT unset and a salt is generated once and kept in the database,
# which is usually what you want. Setting a new value here, or deleting the
# `analytics.salt` row, makes all existing visitor IDs unmatchable — a reset
# switch, not a bug.
ANALYTICS_SALT=
# Page views older than this are deleted daily (default 90).
ANALYTICS_RETENTION_DAYS=90

# ─── Admin account ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@whipandpour.com
ADMIN_PASSWORD=t

# ─── Stripe keys (get from https://dashboard.stripe.com/apikeys) ─────────────
STRIPE_SECRET_KEY=sk_test_your_key_here

# ─── Email (Hostinger SMTP) ───────────────────────────────────────────────────
# Create a mailbox in hPanel → Emails, then use its full address and password.
# Port 465 uses implicit SSL; 587 uses STARTTLS. Both work with Hostinger.
# MAIL_FROM must match SMTP_USER — Hostinger rejects mismatched senders.
MAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=owner@whipandpour.com
SMTP_PASSWORD=your_mailbox_password
MAIL_FROM=owner@whipandpour.com
MAIL_FROM_NAME=Whip & Pour

# Optional: internal copy of every new order (leave blank to disable)
MAIL_ADMIN=owner@whipandpour.com

# Used for the "Track your order" link inside the email, and sitemap.xml
STORE_URL=https://whipandpour.com

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
