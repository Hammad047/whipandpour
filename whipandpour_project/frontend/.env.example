# Copy to .env.production (or set in your deploy platform's build settings)
# cp .env.example .env.production

# Only needed for a split deployment where the backend runs on a different
# domain than the frontend (e.g. frontend on whipandpour.com, backend on
# Render). Leave unset for local dev or a same-origin deployment — the
# frontend then calls the relative /api/trpc path.
VITE_API_URL=https://api.whipandpour.com
