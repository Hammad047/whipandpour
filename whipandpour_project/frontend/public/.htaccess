# SPA fallback for Apache/LiteSpeed static hosting (e.g. Hostinger shared hosting).
# Client-side routing (wouter) means /admin, /shop, /product/<slug> etc. have no
# matching file on disk — without this, a direct load or refresh on any of those
# paths 404s instead of loading the app, which then routes client-side.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>
